# Copy to `.env` for local `export $(cat .env)` workflows if you like — but
# `.env` is gitignored and must stay that way. In Codespaces, set these as
# repository/codespace secrets instead. NEVER commit real values (charter rule 5).

# Required for every database command (local dev default shown; container-only).
DATABASE_URL=postgres://indexer:indexer-local-only@localhost:5432/indexer

# Optional: overrides the public SDF testnet RPC endpoint.
# RPC_URL=https://soroban-testnet.stellar.org

# Optional: GraphQL + /health port.
# PORT=4000
