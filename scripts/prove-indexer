#!/usr/bin/env bash
# Clean-clone proof for the indexer (I7).
#
# Replays the committed raw getEvents fixtures through the same normalization
# path as live ingestion, then queries the RUNNING GraphQL endpoint and compares
# the response with an independent expectation file. Any mismatch exits
# non-zero. Output is written under prove/ (gitignored).
#
# Requires a running indexer (docker compose up / npm run serve) and its
# DATABASE_URL. There is no PASS without an assertion.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

: "${DATABASE_URL:?DATABASE_URL must point at the proof Postgres instance}"
INDEXER_URL="${INDEXER_URL:-http://127.0.0.1:4000/graphql}"
FIXTURES_DIR="${FIXTURES_DIR:-tests/fixtures/replay}"

if [ ! -d "$FIXTURES_DIR" ]; then
  echo "prove-indexer: fixture directory not found: $FIXTURES_DIR" >&2
  exit 1
fi

npm run build
node dist/cli.js migrate
node dist/cli.js replay "$FIXTURES_DIR" --allow-unregistered
node scripts/prove-indexer.mjs "$INDEXER_URL"
