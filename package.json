{
  "name": "governance-event-indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Soroban governance event indexer: raw-event ingestion from public RPC, parser-backed decoding, and a read-only GraphQL API implementing governance-v1.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Stellar-Governance-Guardians/governance-event-indexer.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "premigrate": "npm run build",
    "migrate": "node dist/cli.js migrate"
  },
  "dependencies": {
    "kysely": "^0.28.7",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
