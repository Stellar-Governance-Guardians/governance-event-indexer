# Dependencies and build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Local environment: secrets and runtime config never enter git (charter rule 5).
# Codespaces secrets / env vars are the only source for DATABASE_URL, RPC keys, etc.
.env
.env.*
!.env.example
.seed/

# Local postgres data volume (docker compose)
.pgdata/

# Tooling / editor
.DS_Store
.idea/
.vscode/

# Evidence scratch (regenerated by scripts; committed copies live in evidence/)
.tmp/
